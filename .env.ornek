# Ödev Defteri — ortam değişkenleri
#
# Yerelde: bu dosyayı `.env` olarak kopyalayıp doldurun (`.env` git'e girmez).
# Üretimde: Netlify > Project configuration > Environment variables.

# --- Google OAuth ---------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# İstemci tipi: Web application
# Authorized redirect URI olarak AYNEN şunu ekleyin:
#   https://<alan-adiniz>/api/geridonus
#   http://localhost:8888/api/geridonus      (netlify dev için)
GOOGLE_ISTEMCI_ID=
GOOGLE_ISTEMCI_GIZLI=

# --- Şifreleme ------------------------------------------------------------
# `node scripts/anahtar-uret.mjs` ile üretin.
#
# ANA_ANAHTAR çocukların Google refresh token'larını şifreler.
# KAYBEDİLİRSE tüm bağlantılar kopar ve her çocuğun yeniden izin vermesi
# gerekir. Değiştirmeden önce geçiş planı yapın.
ANA_ANAHTAR=

# Oturum çerezlerini imzalar. Değiştirilirse herkes çıkış yapmış olur
# (zararsız, sadece yeniden giriş gerekir).
OTURUM_GIZLI=

# --- Adres ----------------------------------------------------------------
# Sitenin kök adresi. Üretimde MUTLAKA açıkça verin: tanımsızsa istek
# başlıklarından türetilir ve ters vekil başlıkları sahte olabilir.
SITE_ADRESI=https://odev-defteri.netlify.app

# --- E-posta (giriş bağlantısı) ------------------------------------------
# Boş bırakılırsa bağlantı sunucu günlüğüne yazılır — yalnızca geliştirme.
RESEND_ANAHTAR=
EPOSTA_GONDEREN=Ödev Defteri <giris@alan-adiniz.com>

# Üretimde "uretim" yapın: e-posta yapılandırması eksikse sessizce
# geçilmez, hata verir.
NETLIFY_ORTAM=gelistirme
